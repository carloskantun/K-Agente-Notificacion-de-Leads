# =============================================================================
# WRANGLER.TOML — PLANTILLA DE DESPLIEGUE
# =============================================================================
#
# Este archivo es una PLANTILLA. El script build.js lo procesa y genera
# el wrangler.toml final reemplazando los placeholders {{VARIABLE}}.
#
# NUNCA pongas secrets (API keys, tokens) aquí.
# Los secrets se cargan con: wrangler secret put NOMBRE_SECRET
#
# Documentación oficial: https://developers.cloudflare.com/workers/wrangler/configuration/
# =============================================================================

# ── Identidad del Worker ─────────────────────────────────────────────────────
name = "agente-{{CLIENTE_SLUG}}"
main = "dist/worker.{{CLIENTE_SLUG}}.js"

# Compatibilidad: usa la fecha más reciente que hayas probado
compatibility_date = "2024-09-23"

# ES Modules (obligatorio para export default)
# No es necesario declararlo explícitamente en versiones modernas de Wrangler,
# pero lo incluimos para claridad.

# ── Variables públicas de entorno ────────────────────────────────────────────
# Estas variables son visibles en el dashboard de Cloudflare.
# NO son secrets. Para API keys, usa `wrangler secret put`.
[vars]

# ── Identidad del cliente ──
CLIENTE_NOMBRE    = "{{CLIENTE_NOMBRE}}"

# ── Proveedor y modelo de IA ──
AI_PROVIDER       = "{{AI_PROVIDER}}"
AI_MODEL          = "{{AI_MODEL}}"
AI_TEMPERATURE    = "{{AI_TEMPERATURE}}"
AI_MAX_TOKENS     = "{{AI_MAX_TOKENS}}"

# El prompt del sistema puede ser largo. build.js lo inyecta como string.
AI_SYSTEM_PROMPT  = "{{AI_SYSTEM_PROMPT}}"

# ── Canal de despacho ──
DISPATCH_TYPE     = "{{DISPATCH_TYPE}}"

# ── Configuración Telegram (si DISPATCH_TYPE = "telegram") ──
TELEGRAM_CHAT_ID  = "{{TELEGRAM_CHAT_ID}}"

# ── Configuración Email/Resend (si DISPATCH_TYPE = "email") ──
EMAIL_DESTINATARIOS   = '{{EMAIL_DESTINATARIOS}}'
EMAIL_ASUNTO_PREFIJO  = "{{EMAIL_ASUNTO_PREFIJO}}"
EMAIL_FROM_DOMAIN     = "{{EMAIL_FROM_DOMAIN}}"

# ── Configuración WhatsApp (si DISPATCH_TYPE = "whatsapp") ──
WHATSAPP_NUMERO   = "{{WHATSAPP_NUMERO}}"

# ── Validación del formulario ──
ALLOWED_ORIGINS       = '{{ALLOWED_ORIGINS}}'
REQUIRED_FIELDS       = '{{REQUIRED_FIELDS}}'
MAX_PROBLEMA_LENGTH   = "{{MAX_PROBLEMA_LENGTH}}"

# ── Respuesta al cliente ──
RESPUESTA_CLIENTE     = "{{RESPUESTA_CLIENTE}}"
INCLUDE_COTIZACION    = "{{INCLUDE_COTIZACION}}"

# ── Zona horaria (para timestamps en emails) ──
TIMEZONE              = "{{TIMEZONE}}"


# =============================================================================
# SECRETS — NO van en este archivo.
# Ejecutar UNA VEZ por cliente tras el deploy:
#
#   wrangler secret put OPENAI_API_KEY        --name agente-{{CLIENTE_SLUG}}
#   wrangler secret put GEMINI_API_KEY        --name agente-{{CLIENTE_SLUG}}
#   wrangler secret put TELEGRAM_BOT_TOKEN    --name agente-{{CLIENTE_SLUG}}
#   wrangler secret put RESEND_API_KEY        --name agente-{{CLIENTE_SLUG}}
#
# Cada comando te pedirá el valor de forma segura (sin que quede en el historial
# del terminal si usas la forma interactiva).
# =============================================================================


# ── Límites de uso (opcional pero recomendado en producción) ─────────────────
# [limits]
# cpu_ms = 50       # Límite de CPU por request (default: 50ms en Free)


# ── Observabilidad ───────────────────────────────────────────────────────────
[observability]
enabled = true
head_sampling_rate = 1   # 100% de requests loggeadas (bajar en producción alta)


# =============================================================================
# ENTORNOS (environments) — para staging vs producción
# =============================================================================

# Entorno de staging (usa el mismo nombre con sufijo -staging)
[env.staging]
name = "agente-{{CLIENTE_SLUG}}-staging"

[env.staging.vars]
CLIENTE_NOMBRE   = "{{CLIENTE_NOMBRE}} [STAGING]"
AI_PROVIDER      = "{{AI_PROVIDER}}"
AI_MODEL         = "{{AI_MODEL}}"
AI_TEMPERATURE   = "0.5"
AI_MAX_TOKENS    = "256"
AI_SYSTEM_PROMPT = "{{AI_SYSTEM_PROMPT}}"
DISPATCH_TYPE    = "telegram"
TELEGRAM_CHAT_ID = "{{TELEGRAM_CHAT_ID_STAGING}}"
ALLOWED_ORIGINS  = '["http://localhost:5500","http://127.0.0.1:5500"]'
REQUIRED_FIELDS  = '{{REQUIRED_FIELDS}}'
MAX_PROBLEMA_LENGTH = "{{MAX_PROBLEMA_LENGTH}}"
RESPUESTA_CLIENTE   = "[TEST] {{RESPUESTA_CLIENTE}}"
INCLUDE_COTIZACION  = "{{INCLUDE_COTIZACION}}"
TIMEZONE            = "{{TIMEZONE}}"

# Entorno de producción
[env.production]
name = "agente-{{CLIENTE_SLUG}}"

[env.production.vars]
CLIENTE_NOMBRE    = "{{CLIENTE_NOMBRE}}"
AI_PROVIDER       = "{{AI_PROVIDER}}"
AI_MODEL          = "{{AI_MODEL}}"
AI_TEMPERATURE    = "{{AI_TEMPERATURE}}"
AI_MAX_TOKENS     = "{{AI_MAX_TOKENS}}"
AI_SYSTEM_PROMPT  = "{{AI_SYSTEM_PROMPT}}"
DISPATCH_TYPE     = "{{DISPATCH_TYPE}}"
TELEGRAM_CHAT_ID  = "{{TELEGRAM_CHAT_ID}}"
EMAIL_DESTINATARIOS   = '{{EMAIL_DESTINATARIOS}}'
EMAIL_ASUNTO_PREFIJO  = "{{EMAIL_ASUNTO_PREFIJO}}"
EMAIL_FROM_DOMAIN     = "{{EMAIL_FROM_DOMAIN}}"
WHATSAPP_NUMERO       = "{{WHATSAPP_NUMERO}}"
ALLOWED_ORIGINS       = '{{ALLOWED_ORIGINS}}'
REQUIRED_FIELDS       = '{{REQUIRED_FIELDS}}'
MAX_PROBLEMA_LENGTH   = "{{MAX_PROBLEMA_LENGTH}}"
RESPUESTA_CLIENTE     = "{{RESPUESTA_CLIENTE}}"
INCLUDE_COTIZACION    = "{{INCLUDE_COTIZACION}}"
TIMEZONE              = "{{TIMEZONE}}"
